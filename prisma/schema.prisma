generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  subscriptionStatus String   @default("free")
  tokensRemaining    Int      @default(10)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([email])
}